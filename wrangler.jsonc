{
  // Cloudflare: web estática + un worker mínimo para /api/wx (tiempo real de Cuatro Vientos)
  "name": "atpl-fase0",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] }
}
